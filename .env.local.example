# Copy to .env.local and fill in your own values. Never commit .env.local.
# NEXT_PUBLIC_* values are shipped to the browser - only put public values there.

# ── Anthropic (server only - read in src/app/api/identify) ────────
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional - defaults to claude-sonnet-4-5
ANTHROPIC_MODEL=

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only - used by the webhook and verify-subscription API routes
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── LemonSqueezy payments (server only) ───────────────────────────
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
LEMONSQUEEZY_MONTHLY_VARIANT_ID=your-monthly-variant-id
LEMONSQUEEZY_ANNUAL_VARIANT_ID=your-annual-variant-id
# Set to "true" to use the test-mode variants below
LEMONSQUEEZY_TEST_MODE=false
LEMONSQUEEZY_TEST_MONTHLY_VARIANT_ID=your-test-monthly-variant-id
LEMONSQUEEZY_TEST_ANNUAL_VARIANT_ID=your-test-annual-variant-id

# ── App URLs ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL the native (Capacitor) app calls for API routes
NEXT_PUBLIC_API_BASE_URL=https://your-deployment.vercel.app

# ── Legacy Paddle webhook (src/app/api/paddle/webhook) ────────────
# Not used by the current LemonSqueezy checkout - leave empty unless you still receive Paddle events.
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_YEARLY_PRICE_ID=
